# Example only. Copy to .env to load locally; never add real credentials here.
PORT=8080
APP_MODE=debug
LOG_LEVEL=debug
RATE_LIMIT=120
REQUEST_TIMEOUT=30

# Optional shared key (X-API-Key). Empty means authentication is disabled.
API_KEY=
# Unset/empty uses the built-in read-only allowlist. Non-empty replaces it.
# RPC_METHOD_ALLOWLIST=eth_chainId,eth_blockNumber,eth_getBalance

# Eight EVM adapters plus Bitcoin; Fantom is opt-in.
ETH_RPC_URL=https://ethereum.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
BTC_RPC_URL=https://btc.getblock.io/mainnet
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_ENABLED=true
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_ENABLED=true
OPTIMISM_RPC_URL=https://mainnet.optimism.io
OPTIMISM_ENABLED=true
BASE_RPC_URL=https://mainnet.base.org
BASE_ENABLED=true
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
AVALANCHE_ENABLED=true
FANTOM_RPC_URL=https://rpc.ftm.tools
FANTOM_ENABLED=false

# Optional PostgreSQL storage. Disabled by default; inject credentials at runtime.
DATABASE_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=blockchain_gateway
DB_SSLMODE=disable

# Optional CoinGecko worker; requires DATABASE_ENABLED=true.
MARKET_FETCHER_ENABLED=false
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_PER_PAGE=100
COINGECKO_ORDER=market_cap_desc
COINGECKO_VS_CURRENCY=usd
